@attribute [Authorize(Roles = $"{Roles.AdminRole},{Roles.ManagerRole},{Roles.OperationManagerRole},{Roles.SalesRole}")]
@inherits BasePage
<style>
    .table-responsive {
        overflow-x: auto;
    }

    .table th {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
<MudDialog>
    <DialogContent>
        <div id="unique_id_scroll_section" class="w-100 d-flex flex-column align-items-center py-5" style="height: 60vh;overflow: auto;">
            @if (quotation is null)
            {
                <FormLoadingSpinner IsBigForm="true" />
            }
            else
            {
                <div class="border rounded-lg border-gray-600" style="width:992px;background-color:white !important">
                    <div id="Report" class="px-8 py-5 h-100">
                        <div class="row" dir="rtl" style="direction:rtl;background-color:white !important;">
                            <div class="col-11">
                                <div class="d-flex flex-column h-100">
                                    <div>
                                        <div class="row align-items-center justify-content-between mb-10">
                                            <div class="col-auto px-5">
                                                <div class="d-flex flex-column align-items-center">
                                                    <p class="fs-1 fw-bold text-primary text-center">
                                                        شركة المكافحة المتميزة<br /><span class="text-success">للتشغيل والصيانة</span>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="col-auto px-5">
                                                <MudImage Src="/images/Logo.png" Width="150" />
                                            </div>
                                        </div>
                                        <div class="text-center mb-10">
                                            <div style="width: fit-content;" class="fs-3x fw-bold p-3 m-auto">
                                                عرض سعر
                                            </div>
                                        </div>
                                        <div class="h5 d-flex gap-3 mb-5">
                                            <p>التاريخ: @quotation.CreatedAtLocal?.ToShortDateString()</p>
                                            <p>عرض رقم: @quotation.SerialNumber</p>
                                        </div>
                                        <div class="h5">
                                            <p>
                                                السادة/ @(quotation.Client is null ? quotation.ClientName : $"'{quotation.Client.FirstName} ~ {quotation.Client.LastName}'  الموقرين...")
                                            </p>
                                            <p>
                                                ويمثلهم/ @quotation.Ceo
                                            </p>
                                            <p>
                                                نتشرف بتقديم عرض أسعارنا للخدمات التاليه:
                                            </p>
                                        </div>
                                        <div style="background-image: url(/images/LogoOpacity.png);background-repeat:no-repeat;background-size: 400px 400px;background-position: top;">
                                            @{
                                                if (quotation is not null)
                                                {
                                                    var currency = string.Empty;
                                                    if (quotation.PriceCurrency?.Symbol == "AED")
                                                    {
                                                        currency = "د.إ";
                                                    }
                                                    else if (quotation.PriceCurrency?.Symbol == "SAR")
                                                    {
                                                        currency = "ر.س";
                                                    }
                                                    else if (quotation.PriceCurrency?.Symbol == "EGP")
                                                    {
                                                        currency = "ج.م";
                                                    }
                                                    else if (quotation.PriceCurrency?.Symbol == "$")
                                                    {
                                                        currency = "$";
                                                    }
                                                    <div class="h5">
                                                        <div class="table-responsive">
                                                            <table class="table table-bordered border-gray-800">
                                                                <thead>
                                                                    <tr class="fw-bold fs-6 text-gray-800">
                                                                        <th class="text-center">
                                                                            نوع الخدمة<br />
                                                                            <small class="d-block text-nowrap">Service type</small>
                                                                        </th>
                                                                        <th class="text-center">
                                                                           اسم الفرع<br />
                                                                            <small class="d-block text-nowrap">Branch</small>
                                                                        </th>
                                                                        <th class="text-center">
                                                                            عدد / مساحة<br />
                                                                            <small class="d-block text-nowrap">Qty / Area</small>
                                                                        </th>
                                                                        <th class="text-center">
                                                                            الوحدة<br />
                                                                            <small class="d-block text-nowrap">Unit</small>
                                                                        </th>
                                                                        <th class="text-center">
                                                                            سعر الوحدة (@currency)<br />
                                                                            <small class="d-block text-nowrap">Unit price</small>
                                                                        </th>
                                                                        <th class="text-center">
                                                                            نسبة الخصم<br />
                                                                            <small class="d-block text-nowrap">Discount %</small>
                                                                        </th>
                                                                        <th class="text-center">
                                                                            قيمة الخصم<br />
                                                                            <small class="d-block text-nowrap">Disc value</small>
                                                                        </th>
                                                                        <th class="text-center">
                                                                            المجموع (@currency)<br />
                                                                            <small class="d-block text-nowrap">Total</small>
                                                                        </th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var body in quotation.QuotationBodies)
                                                                    {
                                                                        <tr>
                                                                            <td>@body.Service?.NameAr</td>
                                                                            <td>@body.Branch?.Name</td>
                                                                            <td>
                                                                                @if (body.NoOfVisits != 0)
                                                                                {
                                                                                    @body.NoOfVisits
                                                                                }
                                                                                else if (body.Quantity != 0)
                                                                                {
                                                                                    @body.Quantity
                                                                                }
                                                                                else if (body.Area != 0)
                                                                                {
                                                                                    @body.Area
                                                                                }
                                                                                else
                                                                                {
                                                                                    <text>-</text>
                                                                                }
                                                                            </td>
                                                                            <td>@body.Unit?.Name</td>
                                                                            <td>@(body.Price)</td>
                                                                            <td>@body.DiscountRate %</td>
                                                                            @if (body.Quantity == 0 && body.NoOfVisits == 0 && body.Area != 0)
                                                                            {
                                                                                <td>@(body.DiscountPrice* body.Area)</td>
                                                                            }
                                                                            else if (body.Quantity != 0 && body.NoOfVisits == 0 && body.Area == 0)
                                                                            {
                                                                                <td>@(body.DiscountPrice* body.Quantity)</td>
                                                                            }
                                                                            else if (body.Quantity == 0 && body.NoOfVisits != 0 && body.Area == 0)
                                                                            {
                                                                                <td>@(body.DiscountPrice* body.NoOfVisits)</td>
                                                                            }
                                                                            <td>@(body.TotalPrice)</td>
                                                                        </tr>
                                                                    }
                                                                    <tr>
                                                                        <td colspan="7" class="text-center">
                                                                            المجموع الكلي
                                                                        </td>
                                                                        <td>
                                                                            @(quotation.TotalPrice)
                                                                        </td>
                                                                    </tr>
                                                                </tbody>
                                                            </table>
                                                        </div>


                                                    </div>
                                                }

                                                // <!-- Quote Notes (Bootstrap) -->
                                                <div class="row fw-bold start mt-10">
                                                    <div class="col-6 text-end" lang="ar">
                                                        <div class="mb-1">- هذه الأسعار لا تشمل 15 % ضريبة القيمة المضافة.</div>
                                                        <div class="mb-1">- يعتبر هذا العرض سارٍ لمدة ٧ أيام من تاريخ إصداره.</div>
                                                        <div class="mb-1">- سيتم إصدار الفواتير الشهرية، مع الدفع بالطرق التالية: تحويل بنكي إلى حساب شركة المكافحة المتميزة للتشغيل والصيانة رقم الحساب (البنك الاهلي السعودي) SA0810000010400000477903 من تاريخ بداية العقد.</div>
                                                    </div>
                                                
                                                    <div class="col-6 text-start" dir="ltr">
                                                        <div class="mb-1">- This quote doesn’t include 15% of VAT.</div>
                                                        <div class="mb-1">- This offer is valid for 7 days from the date of issuance.</div>
                                                        <div class="mb-1">- Monthly invoices will be issued, with payment via the following methods: Bank Transfer to the account of company al-mukafahah al-mutamayyizah for operation and maintenance, account number (National Commercial Bank) SA0810000010400000477903 from the starting date.</div>
                                                    </div>
                                                
                                                </div>

                                                // @if (quotation?.Terms is not null && quotation.Terms.Any())
                                                // {
                                                //     <div class="mt-4">
                                                //         <h5 class="fw-bold mb-3">بنود العقد</h5>

                                                //         <div class="row g-3">
                                                //             @* RIGHT: Arabic list-group (YOUR ORIGINAL, unchanged) *@
                                                //             <div class="col-12 col-md-6 text-start" dir="rtl" lang="ar">
                                                //                 <div class="list-group">
                                                //                     @{
                                                //                         var termNumber = 1;
                                                //                     }

                                                //                     @foreach (var term in quotation.Terms)
                                                //                     {
                                                //                         <div class="list-group-item p-3">
                                                //                             <div class="d-flex align-items-center gap-2 mb-1">
                                                //                                 <span class="badge rounded-pill bg-primary">@termNumber</span>
                                                //                                 <span class="fw-bold">@($"{GetTermText(termNumber)} - {term.TitleAr}")</span>
                                                //                             </div>

                                                //                             <div class="fw-normal fs-6 lh-lg text-end">
                                                //                                 @term.TermAr
                                                //                             </div>
                                                //                         </div>

                                                //                         termNumber++;
                                                //                     }
                                                //                 </div>
                                                //             </div>

                                                //             @* LEFT: English list-group *@
                                                //             <div class="col-12 col-md-6 text-end" dir="ltr" lang="en">
                                                //                 <div class="list-group">
                                                //                     @{
                                                //                         var termNumberEn = 1;
                                                //                     }

                                                //                     @foreach (var term in quotation.Terms)
                                                //                     {
                                                //                         <div class="list-group-item p-3">
                                                //                             <div class="d-flex align-items-center gap-2 mb-1">
                                                //                                 <span class="badge rounded-pill bg-primary">@termNumberEn</span>
                                                //                                 <span class="fw-bold">@($"{GetTermTextEn(termNumberEn)} - {term.Title}")</span>
                                                //                             </div>

                                                //                             <div class="fw-normal fs-6 lh-lg text-start">
                                                //                                 @term.Term
                                                //                             </div>
                                                //                         </div>

                                                //                         termNumberEn++;
                                                //                     }
                                                //                 </div>
                                                //             </div>
                                                //         </div>
                                                //     </div>
                                                // }

                                                @if (quotation?.Terms is not null && quotation.Terms.Any())
                                                {
                                                    <div class="mt-4">
                                                        <h5 class="fw-bold mb-3">بنود العقد</h5>

                                                        <div class="list-group">
                                                            @{
                                                                var termNumber = 1;
                                                            }

                                                            @foreach (var term in quotation.Terms)
                                                            {
                                                                <div class="list-group-item p-3">
                                                                    <div class="row g-3 align-items-stretch">
                                                                        @* RIGHT: Arabic (same content) *@
                                                                        <div class="col-6 d-flex text-end" dir="rtl" lang="ar">
                                                                            <div class="w-100 h-100 d-flex flex-column">
                                                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                                                    <span class="badge rounded-pill bg-primary">@termNumber</span>
                                                                                    <span class="fw-bold">@($"{GetTermText(termNumber)} - {term.TitleAr}")</span>
                                                                                </div>

                                                                                <div class="fw-normal fs-6 lh-lg text-end flex-grow-1">
                                                                                    @term.TermAr
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        @* LEFT: English *@
                                                                        <div class="col-6 d-flex text-start" dir="ltr" lang="en">
                                                                            <div class="w-100 h-100 d-flex flex-column">
                                                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                                                    <span class="badge rounded-pill bg-primary">@termNumber</span>
                                                                                    <span class="fw-bold">@($"{GetTermTextEn(termNumber)} - {term.Title}")</span>
                                                                                </div>

                                                                                <div class="fw-normal fs-6 lh-lg text-start flex-grow-1">
                                                                                    @term.Term
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                termNumber++;
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                if (!string.IsNullOrEmpty(quotation?.Notes))
                                                {
                                                    <div class="h3 mt-5 fw-bold text-center">
                                                        <p>ملاحظات</p>
                                                    </div>
                                                    <div class="h5">
                                                        <p>@quotation.Notes</p>
                                                    </div>
                                                }
                                            }
                                            <div style="margin-bottom:60px" class="mt-10">
                                                <p class="fs-4 fw-bold text-start w-100">
                                                    شركة المكافحة المتميزة
                                                </p>
                                            </div>
                                            <div dir="ltr" style="direction:ltr;">
                                                <div class="text-center">
                                                    <a class="align-items-center text-gray-800 text-hover-primary fs-2">
                                                        <i class="ki-duotone ki-geolocation fs-2 me-1">
                                                            <span class="path1"></span>
                                                            <span class="path2"></span>
                                                        </i>
                                                        Bin Hamad Center3 - King Fahd Road - Jeddah, Saudi Arabia
                                                    </a>
                                                </div>
                                                <div class="d-flex justify-content-center mt-10 mb-5">
                                                    <a class="align-items-center text-gray-800 text-hover-primary fs-2 me-3">
                                                        <i class="ki-duotone ki-badge fs-2 me-1">
                                                            <span class="path1"></span>
                                                            <span class="path2"></span>
                                                            <span class="path3"></span>
                                                        </i>
                                                        4030427513
                                                    </a>
                                                    <a class="align-items-center text-gray-800 text-hover-primary fs-2 me-3">
                                                        <i class="ki-duotone ki-tablet fs-2 me-1">
                                                            <span class="path1"></span>
                                                            <span class="path2"></span>
                                                            <span class="path3"></span>
                                                        </i>
                                                        920013270
                                                    </a>
                                                    <a class="align-items-center text-gray-800 text-hover-primary fs-2 me-3">
                                                        <i class="ki-duotone ki-phone fs-2 me-1">
                                                            <span class="path1"></span>
                                                            <span class="path2"></span>
                                                        </i>
                                                        +966 567 780 260
                                                    </a>
                                                    <a class="align-items-center text-gray-800 text-hover-primary fs-2 me-3">
