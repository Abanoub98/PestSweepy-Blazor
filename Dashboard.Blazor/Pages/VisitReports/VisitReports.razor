@page "/VisitReports"
@attribute [Authorize(Roles = $"{Roles.AdminRole},{Roles.ManagerRole},{Roles.SupervisorRole},{Roles.ContractClientRole},{Roles.OperationManagerRole},{Roles.SalesRole}")]
@inherits BasePage

<PageTitle>
    @languageContainer.Keys["Visit Reports"]
</PageTitle>

<MudBreadcrumbs Items="breadcrumbItems"></MudBreadcrumbs>
<BrowserViewportObserver TableHeightChanged="TableHeightChanged" />

<MudCard Elevation="25">
    <MudCardContent>
        <MudDataGrid T="VisitReportsDto" Dense="true" Elevation="0" FixedHeader="true"
                     Height="@($"{tableHight}px")"
                     SelectedItemsChanged="SelectedItemsChanged"
                     Loading="@(isLoading)"
                     LoadingProgressColor="Color.Info"
                     Filterable="true"
                     MultiSelection="true"
                     Items="visitReports"
                     Hover="true"
                     SortMode="SortMode.Single"
                     QuickFilter="@FilterFunc">

            <!-- ==== TOOLBAR ==== -->
            <ToolBarContent>
                <div class="d-flex justify-content-between flex-column align-items-center flex-md-row w-100">
                    <div class="w-md-25 w-100">
                        <div class="d-flex align-items-center">
                            <MudAvatar Rounded="true" Color="Color.Info">
                                <MudIcon Icon="@EntityIcons.VisitReportsIcon" />
                            </MudAvatar>

                            <MudText Class="mx-3" Typo="Typo.h5">
                                @languageContainer.Keys["Visit Reports"]
                            </MudText>

                            @*       <!-- Add -->
                            <MudIconButton OnClick="() => OpenForm(formUri)"
                                           Icon="@Icons.Material.Filled.Add"
                                           Color="Color.Success" /> *@

                            @*     <!-- Delete selected -->
                            <MudIconButton OnClick="DeleteAll"
                                           Disabled="@(selectedIds.Count() < 2 ? true : false)"
                                           Icon="@Icons.Material.Filled.DeleteForever"
                                           Color="Color.Error" /> *@

                            <!-- Refresh -->
                            <MudIconButton OnClick="OnInitializedAsync"
                                           Icon="@Icons.Material.Filled.Refresh"
                                           Color="Color.Info" />
                        </div>
                    </div>

                    <!-- Search -->
                    <div class="w-md-50 w-100">
                        <MudTextField @bind-Value="searchString"
                                      Adornment="Adornment.Start"
                                      Class="mt-0 mb-5"
                                      Immediate="true"
                                      Placeholder=@($"{languageContainer.Keys["Search For"]} {languageContainer.Keys["Visit Id"]}, {languageContainer.Keys["Status"]}, {languageContainer.Keys["Alternate Contact Person"]}")
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="Size.Medium" />
                    </div>
                </div>
            </ToolBarContent>

            <!-- ==== NO RECORDS ==== -->
            <NoRecordsContent>
                <NoDataToDisply />
            </NoRecordsContent>

            <!-- ==== COLUMNS ==== -->
            <Columns>
                <!-- Select -->
                <SelectColumn T="VisitReportsDto" ShowInFooter="false" />

                <!-- Id -->
                <PropertyColumn Property="x => x.Id"
                                Title="@($"{languageContainer.Keys["Id"]}")" />

                <!-- Branch -->
                <PropertyColumn Property="x => x.BranchName"
                                Title="@($"{languageContainer.Keys["Branch"]}")" />

                <!-- Visit Id -->
                <PropertyColumn Property="x => x.VisitId"
                                Title="@($"{languageContainer.Keys["Visit Id"]}")" />

                <!-- Status (Chip) -->
                <TemplateColumn Context="report"
                                Title="@($"{languageContainer.Keys["Status"]}")"
                                Sortable="true"
                                Filterable="true">
                    <HeaderTemplate>
                        <MudText Class="w-100">
                            @($"{languageContainer.Keys["Status"]}")
                        </MudText>
                    </HeaderTemplate>

                    <CellTemplate>
                        @{
                            // If Status is enum, convert to string for matching (NO Trim)
                            var status = report.Item?.Status.ToString() ?? string.Empty;

                            // Normalize ONLY for matching (no Trim)
                            var key = status.Replace(" ", "").ToLowerInvariant();

                            (Color color, string text, string? cssClass) = key switch
                            {
                                "checkedin" => (Color.Info, languageContainer.Keys["CheckedIn"], null),       // blue
                                "inprogress" => (Color.Dark, languageContainer.Keys["InProgress"], null),     // grey
                                "completed" => (Color.Success, languageContainer.Keys["Completed"], null),    // green
                                "cancelled" => (Color.Error, languageContainer.Keys["Cancelled"], ""),      // red
                                _ => (Color.Default, string.IsNullOrWhiteSpace(status) ? "-" : status, null)
                            };
                        }

                        <MudChip Class="@cssClass"
                                 Color="@color"
                                 Variant="Variant.Filled"
                                 Size="Size.Small">
                            @text
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>


                <!-- Check In -->
                <TemplateColumn Context="report"
                                Title="@($"{languageContainer.Keys["Time In"]}")"
                                Sortable="true"
                                Filterable="false"
                                HeaderClass="text-center"
                                CellClass="text-center">
                    <HeaderTemplate>
                        <MudText Class="w-100">
                            @($"{languageContainer.Keys["Time In"]}")
                        </MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudText>@report.Item!.CheckInLocal.ToString("yyyy-MM-dd HH:mm")</MudText>
                    </CellTemplate>
                </TemplateColumn>

                <!-- Check Out -->
                <TemplateColumn Context="report"
                                Title="@($"{languageContainer.Keys["Time Out"]}")"
                                Sortable="true"
                                Filterable="false"
                                HeaderClass="text-center"
                                CellClass="text-center">
                    <HeaderTemplate>
                        <MudText Class="w-100">
                            @($"{languageContainer.Keys["Time Out"]}")
                        </MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (report.Item!.CheckOut.HasValue)
                        {
                            <MudText>@report.Item.CheckOut.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                        }
                        else
                        {
                            <MudText>-</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <!-- Alternate Contact Person -->
                <TemplateColumn Context="report"
                                Title="@($"{languageContainer.Keys["Alternate Contact Person"]}")"
                                Sortable="true"
                                Filterable="true"
                                HeaderClass="text-center"
                                CellClass="text-center">
                    <HeaderTemplate>
                        <MudText Class="w-100">
                            @($"{languageContainer.Keys["Alternate Contact Person"]}")
                        </MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (!string.IsNullOrWhiteSpace(report.Item!.AlternateContactPerson))
                        {
                            <MudText>@report.Item.AlternateContactPerson</MudText>
                        }
                        else
                        {
                            <MudText>-</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <!-- Actions -->
                <TemplateColumn Title="@($"{languageContainer.Keys["Actions"]}")"
                                CellClass="text-center"
                                Context="report"
                                HeaderClass="text-center"
                                Sortable="false"
                                Filterable="false">
                    <HeaderTemplate>
                        <MudText Class="w-100">
                            @($"{languageContainer.Keys["Actions"]}")
                        </MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        <AuthorizeView Roles="Admin,Manager,ContractClient,OperationManager">
                            <Authorized>
                                <div>
                                    @if (report.Item?.CustomerReview == null || report.Item?.CustomerReview == 0)
                                    {
                                        <MudTooltip Text="@languageContainer.Keys["Review"]" Arrow="true">
                                            <MudIconButton Icon="@Icons.Material.Filled.StarRate"
                                                           Color="Color.Warning"
                                                           Disabled="@(report.Item?.Status != "Completed")"
                                                           OnClick="() => OpenVisitReportReview(report.Item!.Id)" />
                                        </MudTooltip>
                                    }
                                    <TableButtons IsDisable="isDisable"
                                                  IsEditHide="true"
                                                  IsDeleteHide="true"
                                                  DetailsClicked="() => OpenDetails(detailsUri, report.Item!.Id)" />
                                </div>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Supervisor">
                            <Authorized>
                                <div>
                                    @if (report.Item!.Status != "Completed")
                                    {
                                        <TableButtons IsDisable="isDisable"
                                                      IsEditHide="true"
                                                      IsDeleteHide="true"
                                                      DetailsClicked="() => OpenDetails(detailsUri, report.Item!.Id)" />

                                        <a href="@formUri/@report.Item!.Id" title="@languageContainer.Keys["Edit Record"]" class="btn btn-sm btn-light-primary me-1">
                                            <i class="fa-solid fa-pen-to-square p-0"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <TableButtons IsDisable="isDisable"
                                                      IsEditHide="true"
                                                      IsDeleteHide="true"
                                                      DetailsClicked="() => OpenDetails(detailsUri, report.Item!.Id)" />
                                    }
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <!-- ==== PAGER ==== -->
            <PagerContent>
                <MudDataGridPager T="VisitReportsDto" />
            </PagerContent>

        </MudDataGrid>
    </MudCardContent>
</MudCard>
