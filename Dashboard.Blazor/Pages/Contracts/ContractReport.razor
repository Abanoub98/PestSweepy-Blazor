@attribute [Authorize(Roles = $"{Roles.AdminRole},{Roles.ManagerRole}")]
@inherits BasePage
<style>
    .table-responsive {
        overflow-x: auto;
    }

    .table th {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<MudDialog>
    <DialogContent>
        <div id="unique_id_scroll_section" class="w-100 d-flex flex-column align-items-center py-5" style="height: 60vh;overflow: auto;">
            @if (contract is null)
            {
                <FormLoadingSpinner IsBigForm="true" />
            }
            else
            {
                <div class="border rounded-lg border-gray-600" style="width:992px;background-color:white !important">
                    <div id="Report" class="px-8 py-5 h-100">
                        <div class="row" dir="rtl" style="direction:rtl;background-color:white !important;">
                            <div class="col-12">
                                <div class="d-flex flex-column h-100">
                                    <div>
                                        <div class="row align-items-center justify-content-between mb-10">
                                            @* RIGHT: Arabic text *@
                                            <div class="col-4 d-flex justify-content-start px-5">
                                                <div class="d-flex flex-column align-items-center">
                                                    <p class="fs-1 fw-bold text-primary text-center">
                                                        شركة المكافحة المتميزة<br />
                                                        <span class="text-success">للتشغيل والصيانة</span>
                                                    </p>
                                                </div>
                                            </div>

                                            @* CENTER: New image *@
                                            <div class="col-4 d-flex justify-content-center">
                                                <MudImage Src="/images/Logo-QR.png" Width="120" />
                                            </div>

                                            @* LEFT: Logo *@
                                            <div class="col-4 d-flex justify-content-end px-5">
                                                <MudImage Src="/images/Logo.png" Width="150" />
                                            </div>
                                        </div>

                                        <!-- Title -->
                                        <div class="text-center mb-4">
                                            <div class="d-inline-block fs-4 fw-bold border border-dark border-1 rounded-2 px-4 py-2">
                                                @contract.Title
                                            </div>
                                        </div>

                                        <!-- Dates + Serial Number: AR right / EN left (4 lines under each other) -->
                                        <div class="row mb-4 fw-bolder text-start">
                                            <div class="col-12">
                                                <div>Contract Serial Number: @contract.SerialNumber</div>
                                                <div>Contract Create Date: @(contract.CreatedAtLocal.ToString("dd/MM/yyyy"))</div>
                                                <div>Contract Effective Date: @(contract.EffectiveDateLocal?.ToString("dd/MM/yyyy"))</div>
                                                <div>Contract End Date: @(contract.EndDateLocal?.ToString("dd/MM/yyyy"))</div>
                                            </div>
                                        </div>

                                        <!-- Basic Details (like the screenshot) -->
                                        <div class="row mb-4">

                                            <!-- RIGHT: Arabic -->
                                            <div class="col-6 text-end" dir="rtl" lang="ar">

                                                <div class="fw-bold mb-2">الطرف الأول: @((contract?.CompanyInfo?.CompanyName.SplitLocalized("ar") ?? "-"))</div>
                                                <div>السجل التجاري: @((contract?.CompanyInfo?.CommercialRegistrationNo ?? "-"))</div>
                                                <div>الرقم الضريبي: @((contract?.CompanyInfo?.VatRegistrationNumber ?? "-"))</div>
                                                <div>العنوان: @((contract?.CompanyInfo?.Address.SplitLocalized("ar") ?? "-"))</div>
                                                <div>رقم الهاتف: @((contract?.CompanyInfo?.ContactPhone ?? "-"))</div>
                                                <div>رقم الجوال: @((contract?.CompanyInfo?.ContactMobile ?? "-"))</div>
                                                <div>البريد الإلكتروني: @((contract?.CompanyInfo?.ContactEmail ?? "-"))</div>

                                                <div class="fw-bold mt-4 mb-2">الطرف الثاني: @((contract?.ContractClient is null) ? "-" : $"{contract.ContractClient.LastName}")</div>
                                                <div>السجل التجاري: @((contract?.ContractClient?.CommercialRegistrationNo ?? "-"))</div>
                                                <div>الرقم الضريبي: @((contract?.ContractClient?.VatRegistrationNumber ?? "-"))</div>
                                                <div>العنوان: @((contract?.ContractClient?.Address.SplitLocalized("ar") ?? "-"))</div>
                                                <div>رقم الهاتف: @((contract?.ContractClient?.ContactPhone ?? "-"))</div>
                                                <div>رقم الجوال: @((contract?.ContractClient?.ContactMobile ?? "-"))</div>
                                                <div>البريد الإلكتروني: @((contract?.ContractClient?.ContactEmail ?? "-"))</div>

                                                <div class="mt-3">اسم المسؤول من طرف العميل: @((contract?.SpExecutiveOfficer.SplitLocalized("ar") ?? "-"))</div>
                                                <div>المسمى الوظيفي للمسؤول: @((contract?.SpExecutiveOfficerJob.SplitLocalized("ar") ?? "-"))</div>
                                            </div>

                                            <!-- LEFT: English -->
                                            <!-- LEFT: English -->
                                            <div class="col-6 text-start" dir="ltr" lang="en">

                                                <div class="fw-bold mb-2">
                                                    First party: @((contract?.CompanyInfo?.CompanyName.SplitLocalized("en") ?? "-"))
                                                </div>
                                                <div>Commercial number: @((contract?.CompanyInfo?.CommercialRegistrationNo ?? "-"))</div>
                                                <div>VAT number: @((contract?.CompanyInfo?.VatRegistrationNumber ?? "-"))</div>
                                                <div>Location: @((contract?.CompanyInfo?.Address.SplitLocalized("en") ?? "-"))</div>
                                                <div>Telephone number: @((contract?.CompanyInfo?.ContactPhone ?? "-"))</div>
                                                <div>Phone number: @((contract?.CompanyInfo?.ContactMobile ?? "-"))</div>
                                                <div>E-mail: @((contract?.CompanyInfo?.ContactEmail ?? "-"))</div>

                                                <div class="fw-bold mt-4 mb-2">
                                                    Second party: @((contract?.ContractClient is null) ? "-" : $"{contract.ContractClient.FirstName}")
                                                </div>
                                                <div>Commercial number: @((contract?.ContractClient?.CommercialRegistrationNo ?? "-"))</div>
                                                <div>VAT number: @((contract?.ContractClient?.VatRegistrationNumber ?? "-"))</div>
                                                <div>Location: @((contract?.ContractClient?.Address.SplitLocalized("en") ?? "-"))</div>
                                                <div>Telephone number: @((contract?.ContractClient?.ContactPhone ?? "-"))</div>
                                                <div>Phone number: @((contract?.ContractClient?.PhoneNumber ?? "-"))</div>
                                                <div>E-mail: @((contract?.ContractClient?.ContactEmail ?? "-"))</div>

                                                <div class="mt-3">HOD name: @((contract?.SpExecutiveOfficer.SplitLocalized("en") ?? "-"))</div>
                                                <div>HOD position: @((contract?.SpExecutiveOfficerJob.SplitLocalized("en") ?? "-"))</div>

                                            </div>


                                        </div>

                                        @{
                                            var quotation = contract?.Quotation;

                                            <section class="mb-10 mt-10">
                                                <div class="row" dir="rtl" style="direction:rtl;background-color:white !important;">
                                                    <div class="col-12">
                                                        <div class="d-flex flex-column h-100">
                                                            <div>
                                                                <div class="text-center mb-5">
                                                                    <div style="width: fit-content;" class="fs-5 fw-bold p-3 m-auto text-center">
                                                                        عرض السعر موضوع العقد - Contract Quotation
                                                                    </div>
                                                                </div>
                                                                <div class="h5 d-flex gap-3 mb-5">
                                                                    <p>عرض رقم: @quotation.SerialNumber</p>
                                                                </div>
                                                                <div>
                                                                    @{
                                                                        if (quotation is not null)
                                                                        {
                                                                            var currency = string.Empty;
                                                                            if (quotation.PriceCurrency?.Symbol == "AED")
                                                                            {
                                                                                currency = "د.إ";
                                                                            }
                                                                            else if (quotation.PriceCurrency?.Symbol == "SAR")
                                                                            {
                                                                                currency = "ر.س";
                                                                            }
                                                                            else if (quotation.PriceCurrency?.Symbol == "EGP")
                                                                            {
                                                                                currency = "ج.م";
                                                                            }
                                                                            else if (quotation.PriceCurrency?.Symbol == "$")
                                                                            {
                                                                                currency = "$";
                                                                            }
                                                                            <div class="h5">
                                                                                <div class="table-responsive">
                                                                                    <table class="table table-bordered border-gray-800">
                                                                                        <thead>
                                                                                            <tr class="fw-bold fs-6 text-gray-800">
                                                                                                <th class="text-center">
                                                                                                    نوع الخدمة<br />
                                                                                                    <small class="d-block text-nowrap">Service type</small>
                                                                                                </th>                                                                                   
                                                                                                <th class="text-center">
                                                                                                    اسم الفرع<br />
                                                                                                    <small class="d-block text-nowrap">Branch</small>
                                                                                                </th>
                                                                                                <th class="text-center">
                                                                                                    عدد / مساحة<br />
                                                                                                    <small class="d-block text-nowrap">Qty / Area</small>
                                                                                                </th>
                                                                                                <th class="text-center">
                                                                                                    الوحدة<br />
                                                                                                    <small class="d-block text-nowrap">Unit</small>
                                                                                                </th>
                                                                                                <th class="text-center">
                                                                                                    سعر الوحدة (@currency)<br />
                                                                                                    <small class="d-block text-nowrap">Unit price</small>
                                                                                                </th>
                                                                                                <th class="text-center">
                                                                                                    نسبة الخصم<br />
                                                                                                    <small class="d-block text-nowrap">Discount %</small>
                                                                                                </th>
                                                                                                <th class="text-center">
                                                                                                    قيمة الخصم<br />
                                                                                                    <small class="d-block text-nowrap">Dis value</small>
                                                                                                </th>
                                                                                                <th class="text-center">
                                                                                                    المجموع (@currency)<br />
                                                                                                    <small class="d-block text-nowrap">Total</small>
                                                                                                </th>
                                                                                            </tr>
                                                                                        </thead>
                                                                                        <tbody>
                                                                                            @foreach (var body in quotation.QuotationBodies)
                                                                                            {
                                                                                                <tr>
                                                                                                    <td>@body.Service?.NameAr</td>
                                                                                                    <td>@body.Branch?.Name</td>
                                                                                                    <td>
                                                                                                        @if (body.NoOfVisits != 0)
                                                                                                        {
                                                                                                            @body.NoOfVisits
                                                                                                        }
                                                                                                        else if (body.Quantity != 0)
                                                                                                        {
                                                                                                            @body.Quantity
                                                                                                        }
                                                                                                        else if (body.Area != 0)
                                                                                                        {
                                                                                                            @body.Area
                                                                                                        }
                                                                                                        else
                                                                                                        {
                                                                                                            <text>-</text>
                                                                                                        }
                                                                                                    </td>
                                                                                                    <td>@body.Unit?.Name</td>                                                                                         
                                                                                                    <td>@(body.Price)</td>
                                                                                                    <td>@body.DiscountRate %</td>
                                                                                                    @if (body.Quantity == 0 && body.NoOfVisits == 0 && body.Area != 0)
                                                                                                    {
                                                                                                        <td>@(body.DiscountPrice* body.Area)</td>
                                                                                                    }
                                                                                                    else if (body.Quantity != 0 && body.NoOfVisits == 0 && body.Area == 0)
                                                                                                    {
                                                                                                        <td>@(body.DiscountPrice* body.Quantity)</td>
                                                                                                    }
                                                                                                    else if (body.Quantity == 0 && body.NoOfVisits != 0 && body.Area == 0)
                                                                                                    {
                                                                                                        <td>@(body.DiscountPrice* body.NoOfVisits)</td>
                                                                                                    }
                                                                                                    <td>@(body.TotalPrice)</td>
                                                                                                </tr>
                                                                                            }
                                                                                            <tr>
                                                                                                <td colspan="7" class="text-center">
                                                                                                    المجموع الكلي
                                                                                                </td>
                                                                                                <td>
                                                                                                    @(quotation.TotalPrice)
                                                                                                </td>
                                                                                            </tr>
                                                                                        </tbody>
                                                                                    </table>
                                                                                </div>


                                                                            </div>
                                                                        }

                                                                        // <!-- Quote Notes (Bootstrap) -->
                                                                        <div class="row fw-bold start mt-10">
                                                                            <div class="col-6 text-end" lang="ar">
                                                                                <div class="mb-1">- هذه الأسعار لا تشمل 15 % ضريبة القيمة المضافة.</div>
                                                                                <div class="mb-1">- سيتم إصدار الفواتير الشهرية، مع الدفع بالطرق التالية: تحويل بنكي إلى حساب شركة المكافحة المتميزة للتشغيل والصيانة رقم الحساب (البنك الاهلي السعودي) SA0810000010400000477903 من تاريخ بداية العقد.</div>
                                                                            </div>

                                                                            <div class="col-6 text-start" dir="ltr">
                                                                                <div class="mb-1">- This quote doesn’t include 15% of VAT.</div>
                                                                                <div class="mb-1">- Monthly invoices will be issued, with payment via the following methods: Bank Transfer to the account of company al-mukafahah al-mutamayyizah for operation and maintenance, account number (National Commercial Bank) SA0810000010400000477903 from the starting date.</div>
                                                                            </div>

                                                                        </div>

                                                                        @if (quotation?.Terms is not null && quotation.Terms.Any())
                                                                        {
                                                                            <div class="mt-4 mb-3">
                                                                                <h5 class="fw-bold mb-3">بنود العرض - Quotation Clauses</h5>

                                                                                <div class="list-group">
                                                                                    @{
                                                                                        var termNumber = 1;
                                                                                    }

                                                                                    @foreach (var term in quotation.Terms)
                                                                                    {
                                                                                        <div class="list-group-item p-3">
                                                                                            <div class="row g-3 align-items-stretch">
                                                                                                @* RIGHT: Arabic (same content) *@
                                                                                                <div class="col-6 d-flex text-end" dir="rtl" lang="ar">
                                                                                                    <div class="w-100 h-100 d-flex flex-column">
                                                                                                        <div class="d-flex align-items-center gap-2 mb-1">
                                                                                                            <span class="badge rounded-pill bg-primary">@termNumber</span>
                                                                                                            <span class="fw-bold">@($"{GetTermText(termNumber)} - {term.TitleAr}")</span>
                                                                                                        </div>

                                                                                                        <div class="fw-normal fs-6 lh-lg text-end flex-grow-1">
                                                                                                            @term.TermAr
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </div>

                                                                                                @* LEFT: English *@
                                                                                                <div class="col-6 d-flex text-start" dir="ltr" lang="en">
                                                                                                    <div class="w-100 h-100 d-flex flex-column">
                                                                                                        <div class="d-flex align-items-center gap-2 mb-1">
                                                                                                            <span class="badge rounded-pill bg-primary">@termNumber</span>
                                                                                                            <span class="fw-bold">@($"{GetTermTextEn(termNumber)} - {term.Title}")</span>
                                                                                                        </div>

                                                                                                        <div class="fw-normal fs-6 lh-lg text-start flex-grow-1">
                                                                                                            @term.Term
                                                                                                        </div>
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>

                                                                                        termNumber++;
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                        }

                                                                        if (!string.IsNullOrEmpty(quotation?.Notes))
                                                                        {
                                                                            <div class="h3 mt-5 fw-bold text-center">
                                                                                <p>ملاحظات</p>
                                                                            </div>
                                                                            <div class="h5">
                                                                                <p>@quotation.Notes</p>
                                                                            </div>
                                                                        }
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </section>
                                        }

                                        <!-- Bootstrap 5 - Contract Clauses (Static AR/EN) -->

                                        <section class="mb-10">
                                            <div class="d-flex align-items-center justify-content-between mb-3">
                                                <h4 class="m-0 fw-bold">اتفق الطرفان على البنود الأساسية التالية:</h4>
                                                @*  <span class="badge bg-secondary">13 Clauses</span> *@
                                            </div>

                                            <div class="row mt-4 align-items-start">
                                                <!-- RIGHT: Arabic -->
                                                <div class="col-6 text-end" dir="rtl" lang="ar">
                                                    <table class="table table-bordered border-dark text-end">
                                                        <tbody class="fw-bold">
                                                            <tr>
                                                                <td style="width:25%">قيمة العقد</td>
                                                                <td>@($"{contract?.Quotation?.TotalPrice} ريال (غير شامل ضريبة القيمة المضافة 15%).")</td>
                                                            </tr>

                                                            <tr>
                                                                <td>مدة العقد</td>
                                                                <td>
                                                                    تاريخ البداية: @contract?.EffectiveDateLocal?.ToShortDateString()
                                                                    &nbsp;&nbsp;
                                                                    تاريخ النهاية: @contract?.EndDateLocal?.ToShortDateString()
                                                                </td>
                                                            </tr>

                                                            <tr>
                                                                <td>نوع العقد</td>
                                                                <td>@(contract?.ContractDuration?.Name.SplitLocalized("ar") ?? "-")</td>
                                                            </tr>

                                                            <tr>
                                                                <td>طريقة السداد</td>
                                                                <td>@(contract?.PaymentMethod.Name.SplitLocalized("ar") ?? "-")</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <!-- LEFT: English -->
                                                <div class="col-6 text-start" dir="ltr" lang="en">
                                                    <table class="table table-bordered border-dark">
                                                        <tbody class="fw-bold">
                                                            <tr>
                                                                <td style="width:35%">Contract Value</td>
                                                                <td>@($"{contract?.Quotation?.TotalPrice} SAR (VAT 15% Excluded).")</td>
                                                            </tr>

                                                            <tr>
                                                                <td>Contract Duration</td>
                                                                <td>
                                                                    Start: @contract?.EffectiveDateLocal?.ToShortDateString()
                                                                    &nbsp;
                                                                    End: @contract?.EndDateLocal?.ToShortDateString()
                                                                </td>
                                                            </tr>

                                                            <tr>
                                                                <td>Contract Type</td>
                                                                <td>@(contract?.ContractDuration?.Name.SplitLocalized("en") ?? "-")</td>
                                                            </tr>

                                                            <tr>
                                                                <td>Payment Method</td>
                                                                <td>@(contract?.PaymentMethod.Name.SplitLocalized("en") ?? "-")</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>

                                            <!-- 1 -->
                                            <div class="mb-3">
                                                <div class="row g-3">
                                                    <div class="col-6 text-end" dir="rtl" lang="ar">
                                                        <div class="fw-bold mb-2">1. التوضيح</div>
                                                        <div class="mb-2">1.1 تشكل هذه الشروط والأحكام العامة، واتفاقية البيع، وعرض السعر المحدد للخدمات والرسوم، وأي جداول أو شروط خاصة مرفقة ("الاتفاقية")، وتُعتبر ملحقات العقد بجميع صفاتها ومسمياتها جزءًا أساسيًا من الاتفاقية.</div>
                                                        <div class="mb-2">1.2 في هذا العقد يُعتبر:</div>
                                                        <div>1.2.1 "الطرف الأول" مشارًا إليه كمورد ومنفذ في عرض السعر.</div>
                                                        <div>1.2.2 "الطرف الثاني" مشارًا إليه كعميل في عرض السعر.</div>
                                                    </div>

                                                    <div class="col-6 text-start" dir="ltr" style="font-size:11px">
                                                        <div class="fw-bold mb-2">1. Clarification</div>
                                                        <div class="mb-2">1.1. These General Terms and Conditions, the Sales Agreement, the Quotation specifying the services and fees, and any attached schedules or special conditions (the “Agreement”) shall collectively constitute the Agreement. All annexes to the contract, in all their forms and titles, shall be deemed an integral part of the Agreement.</div>
                                                        <div class="mb-2">1.2. For the purposes of this Contract:</div>
                                                        <div>1.2.1. “First Party” shall mean the Supplier and Service Provider as identified in the Quotation.</div>
                                                        <div>1.2.2. “Second Party” shall mean the Client as identified in the Quotation.</div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- 2 -->
                                            <div class="mb-3">
                                                <div class="row g-3">
                                                    <div class="col-6 text-end" dir="rtl" lang="ar">
                                                        <div class="fw-bold mb-2">2. الالتزامات</div>
                                                        <div class="mb-2">2.1 يلتزم الطرف الأول "المورد" بتقديم الخدمات المحددة مسبقًا في عرض السعر، أو تقديم خدمات روتينية منتظمة بالتردد المحدد في عرض السعر.</div>
                                                        <div class="mb-2">2.2 يلتزم الطرف الثاني "العميل" بتوفير جميع وسائل الوصول والمرافق وتهيئتها ليتمكن المورد من تقديم خدماته على الوجه المطلوب.</div>
                                                        <div class="mb-2">2.3 يلتزم الطرف الثاني "العميل" باتباع نصائح وإرشادات الصحة والسلامة التي يقدمها المورد والامتثال لها، ولا يعتبر المورد مسؤولًا عن مشاكل الإهمال الصحي لدى العميل وعدم اتباعه الإرشادات والتوصيات.</div>
                                                        <div>2.4 يلتزم الطرف الأول "المورد" بتقديم التحذيرات والإرشادات الوقائية للعميل في مرافق العقد في حالة وجود أي مواد خطرة على الصحة والسلامة، ويحتفظ المورد بالحق في رفض تقديم أي خدمات في المناطق الملوثة، أو المتأثرة بمواد خطرة، أو مواد قابلة للاشتعال.</div>
                                                    </div>

                                                    <div class="col-6 text-start" dir="ltr" style="font-size:11px">
                                                        <div class="fw-bold mb-2">2. Obligations</div>
                                                        <div class="mb-2">2.1. The First Party (the “Supplier”) shall be obligated to provide the services specified in the Quotation, or to perform regular routine services at the frequency stated in the Quotation.</div>
                                                        <div class="mb-2">2.2. The Second Party (the “Client”) shall be obligated to provide and facilitate all necessary access, utilities, and facilities required for the Supplier to properly perform its services.</div>
                                                        <div class="mb-2">2.3. The Second Party (the “Client”) shall comply with and adhere to the health and safety advice and instructions provided by the Supplier. The Supplier shall not be held liable for any issues arising from the Client’s negligence or failure to follow the provided instructions and recommendations.</div>
                                                        <div>2.4. The First Party (the “Supplier”) shall provide the Client with all necessary warnings and preventive instructions in relation to the contract facilities if any materials hazardous to health and safety are involved. The Supplier reserves the right to refuse to provide any services in contaminated areas, or in areas affected by hazardous or flammable substances.</div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- 3 -->
                                            <div class="mb-3">
                                                <div class="row g-3">
                                                    <div class="col-6 text-end" dir="rtl" lang="ar">
                                                        <div class="fw-bold mb-2">3. الدفع</div>
                                                        <div class="mb-2">3.1 يدفع الطرف الثاني "العميل" المبالغ المستحقة للمورد والالتزام بطرق الدفع المتفق عليها من الطرفين في عرض السعر (وهي لا تشمل ضريبة القيمة المضافة 15% ويتم تحميلها على فاتورة العميل) دون أي مقاصة أو خصم غير مذكور بعرض السعر، بحلول تاريخ الاستحقاق.</div>
                                                        <div class="mb-2">3.2 تحدد المستحقات الواجب سدادها على الطرف الثاني "العميل" بداية من توقيعه أو من تاريخ بدء الخدمات أو التوريدات أيهما أسبق، حسب المدة المتفق عليها للتوريد أو تنفيذ الخدمات، ولا يجوز زيادة الرسوم والمستحقات إلا بعد انقضاء المدة المتفق عليها.</div>
                                                        <div class="mb-2">3.3 لا يحق للطرف الثاني "العميل" استرداد قيمة الزيارات الدورية أو قيمة الخدمات أو تكلفة النقل والتوريد في حالة عدم التزامه بالبند رقم 2.2، لعدم سماحه للمورد بالوصول وعدم تقديم التعليمات المناسبة قبل 24 ساعة على الأقل من تاريخ جدولة تقديم الخدمة أو تاريخ التوريد.</div>
                                                        <div>3.4 في حالة تخلف الطرف الثاني "العميل" عن دفع المستحقات المطلوبة لمدة 14 يومًا من تاريخ إصدار الفاتورة، يتم إخطاره خطيًا أو عن طريق البريد الإلكتروني، ويحق للطرف الأول "المورد" اتخاذ الإجراءات القانونية ضد الطرف الثاني بعد انقضاء 30 يومًا من تاريخ أول إخطار.</div>
                                                    </div>

                                                    <div class="col-6 text-start" dir="ltr" style="font-size:11px">
                                                        <div class="fw-bold mb-2">3. Payment</div>
                                                        <div class="mb-2">3.1. The Second Party (the “Client”) shall pay the amounts due to the Supplier and comply with the payment methods agreed upon by both parties in the Quotation (which do not include 15% Value Added Tax, to be added to the Client’s invoice), without any set-off or deduction not specified in the Quotation, by the due date.</div>
                                                        <div class="mb-2">3.2. The amounts payable by the Second Party (the “Client”) shall be calculated starting from the date of signature or from the commencement date of the services or supplies, whichever occurs first, in accordance with the agreed duration for supply or service execution. The fees and charges may not be increased except after the expiry of the agreed term.</div>
                                                        <div class="mb-2">3.3. The Second Party (the “Client”) shall not be entitled to claim a refund for scheduled periodic visits, service fees, transportation costs, or supply charges in the event of non-compliance with Clause 2.2, including failure to grant the Supplier access or failure to provide proper notice at least twenty-four (24) hours prior to the scheduled service or supply date.</div>
                                                        <div>3.4. If the Second Party (the “Client”) fails to pay the amounts due within fourteen (14) days from the invoice issuance date, the Client shall be notified in writing or by email. The First Party (the “Supplier”) shall have the right to take legal action against the Second Party after thirty (30) days from the date of the first notice.</div>
