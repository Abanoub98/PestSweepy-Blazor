@attribute [Authorize]

<MudDialog DisableSidePadding="true">
    <DialogContent>
        <MudContainer Style="max-height: 300px; overflow-y: scroll">
            <MudText Style="word-wrap: break-word;color: #dc3545; font-weight: 600; white-space: pre-line">@languageContainer.Keys[Error]</MudText>
        </MudContainer>
    </DialogContent>
</MudDialog>

@code{
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter][EditorRequired] public string Error { set; get; } = null!;

    private void Ok()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}
