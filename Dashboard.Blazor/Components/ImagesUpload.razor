@attribute [Authorize]

<div class="d-flex flex-column">
    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                   FilesChanged="LoadImages"
                   Accept=".jpg, .jpeg, .png"
                   Multiple="true">

        <ButtonTemplate>
            <MudButton Size="Size.Large"
                       Variant="Variant.Filled"
                       DisableElevation="true"
                       HtmlTag="label"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Image"
                       for="@context">
                Upload Images
            </MudButton>
        </ButtonTemplate>

        <SelectedTemplate>
            @if (uploadedImages.Any())
            {
                <div class="d-flex flex-wrap gap-3 mt-3">
                    @foreach (var item in uploadedImages)
                    {
                        <div class="d-flex flex-column align-items-center border rounded p-2" style="width:120px;">
                            <MudAvatar Elevation="25" Rounded="true" Style="height:80px; width:80px;">
                                <MudImage Class="cursor-all-scroll"
                                          Src="@item.PreviewUrl"
                                          @onclick="() => ShowImagePreview(item.PreviewUrl)">
                                </MudImage>
                            </MudAvatar>

                            <MudText Class="mt-2 text-truncate w-100 text-center"
                                     Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size:12px;">
                                @item.File.Name
                            </MudText>

                            <MudIconButton OnClick="() => RemoveImage(item.File)"
                                           Icon="@Icons.Material.Filled.Cancel"
                                           Color="Color.Error">
                            </MudIconButton>
                        </div>
                    }
                </div>

                <div class="mt-3">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.DeleteSweep"
                               OnClick="ClearAll">
                        Clear All
                    </MudButton>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center mt-2">
                    <MudText Class="me-2">No selected images</MudText>
                    <MudIconButton Disabled="true"
                                   Icon="@Icons.Material.Filled.HideImage"
                                   Color="Color.Info">
                    </MudIconButton>
                </div>
            }
        </SelectedTemplate>
    </MudFileUpload>

    @if (CurrentImages is not null && CurrentImages.Any())
    {
        <div class="d-flex flex-wrap gap-3 mt-4">
            @foreach (var image in CurrentImages)
            {
                <div class="d-flex flex-column align-items-center border rounded p-2" style="width:120px;">
                    <MudAvatar Elevation="25" Rounded="true" Style="height:80px; width:80px;">
                        <MudImage Class="cursor-all-scroll"
                                  Src="@image"
                                  @onclick="() => ShowImagePreview(image)">
                        </MudImage>
                    </MudAvatar>

                    <MudText Class="mt-2 text-truncate w-100 text-center"
                             Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size:12px;">
                        Existing Image
                    </MudText>
                </div>
            }
        </div>
    }
</div>